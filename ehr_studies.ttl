#################################################################
#    Annotation properties
#################################################################

###  http://purl.obolibrary.org/obo/BFO_0000050
ro:BFO_0000050 rdf:type owl:AnnotationProperty .


###  http://purl.obolibrary.org/obo/BFO_0000051
ro:BFO_0000051 rdf:type owl:AnnotationProperty .


###  http://purl.obolibrary.org/obo/RO_0002502
ro:RO_0002502 rdf:type owl:AnnotationProperty .


###  http://pgxo.loria.fr/causes
pgxo:causes rdf:type owl:AnnotationProperty .


###  http://pgxo.loria.fr/isCausedBy
pgxo:isCausedBy rdf:type owl:AnnotationProperty .


###  http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#hasDataValue
dul:hasDataValue rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://pgxo.loria.fr/qualifiedProxy
pgxo:qualifiedProxy rdf:type owl:ObjectProperty .


###  http://pgxo.loria.fr/qualifiedVariation
pgxo:qualifiedVariation rdf:type owl:ObjectProperty .


###  http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#hasQuality
